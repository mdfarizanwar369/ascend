NODE_ENV=development

# Frontend values may also be copied to frontend/.env.local
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=
NEXT_PUBLIC_FOOD_AI_PERFORMANCE_LOGS=false
NEXT_PUBLIC_ONBOARDING_VERSION=v2
NEXT_PUBLIC_GOOGLE_SIGN_IN_ENABLED=false
NEXT_PUBLIC_AUTH_DEBUG=false
ONBOARDING_VERSION=v2

# Backend values may also be copied to backend/.env
PORT=4000
DATABASE_URL=postgres://ascend:ascend@localhost:5432/ascend
CORS_ORIGIN=http://localhost:3000
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
BOOTSTRAP_OWNER_EMAIL=you@example.com
CRON_SECRET=replace-with-a-long-random-string

# AWS S3
AWS_REGION=ap-southeast-1
AWS_S3_ENDPOINT=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=

# AI
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
AI_MONTHLY_SPEND_LIMIT_CENTS=5000
AI_MONTHLY_FOOD_ANALYSIS_LIMIT=1000
AI_MONTHLY_CHAT_LIMIT=3000
AI_MONTHLY_WEEKLY_REPORT_LIMIT=500
AI_FOOD_ANALYSIS_ESTIMATED_COST_CENTS=2
AI_CHAT_ESTIMATED_COST_CENTS=1
AI_WEEKLY_REPORT_ESTIMATED_COST_CENTS=2
FOOD_AI_PERFORMANCE_LOGS=false
BODY_COMPOSITION_AI_DEBUG_LOGS=false

# Athlete Mode kill switch
ATHLETE_MODE_ENABLED=true

# ToyyibPay legacy fallback
TOYYIBPAY_BASE_URL=https://toyyibpay.com
TOYYIBPAY_SECRET_KEY=
TOYYIBPAY_CATEGORY_CODE=
TOYYIBPAY_RETURN_URL=http://localhost:3000/subscription
TOYYIBPAY_CALLBACK_URL=http://localhost:4000/api/v1/webhooks/toyyibpay

# Stripe
PAYMENT_PROVIDER=stripe
FRONTEND_URL=http://localhost:3000
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PREMIUM_PRICE_ID=
STRIPE_TRAINER_PRO_PRICE_ID=

# Founder Dashboard Gmail API
# Google Cloud OAuth Web Client. Redirect URI should point to:
# https://YOUR_API_DOMAIN/api/v1/founder/gmail/callback
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://localhost:4000/api/v1/founder/gmail/callback
GMAIL_TOKEN_ENCRYPTION_KEY=

# Android wrapper (Capacitor)
CAPACITOR_ANDROID_SERVER_URL=https://www.getascend.fit/launch
CAPACITOR_ANDROID_FIREBASE_API_KEY=
CAPACITOR_ANDROID_FIREBASE_APP_ID=
CAPACITOR_ANDROID_FIREBASE_PROJECT_ID=
CAPACITOR_ANDROID_FIREBASE_MESSAGING_SENDER_ID=
CAPACITOR_ANDROID_FIREBASE_STORAGE_BUCKET=
CAPACITOR_ANDROID_GOOGLE_WEB_CLIENT_ID=
ASCEND_ANDROID_VERSION_CODE=1
ASCEND_ANDROID_VERSION_NAME=0.1.0

# Private Workout Capture V1 pilot. Both flags must be true to expose and serve it.
WORKOUT_CAPTURE_V1=false
NEXT_PUBLIC_WORKOUT_CAPTURE_V1=false

# Shared deterministic progression for confirmed detailed workouts. Both flags must be enabled to display it.
WORKOUT_PROGRESSION_INTELLIGENCE_V1=false
NEXT_PUBLIC_WORKOUT_PROGRESSION_INTELLIGENCE_V1=false
WORKOUT_PROGRESSION_INTELLIGENCE_V3=false
NEXT_PUBLIC_WORKOUT_PROGRESSION_INTELLIGENCE_V3=false

# Trainer-led PT Session Capture V1. Keep disabled until private testing is approved.
TRAINER_SESSION_CAPTURE_V1=false
NEXT_PUBLIC_TRAINER_SESSION_CAPTURE_V1=false

# Seven-day Fuel / Move / Recover / Focus Momentum model. Set false for instant legacy rollback.
MOMENTUM_V2=true
