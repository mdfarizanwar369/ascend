NODE_ENV=development
ASCEND_APP_ENV=local
ASCEND_BILLING_CHANNEL=web_stripe
ASCEND_PRODUCTION_DATABASE_URL_SHA256=
ASCEND_PRODUCTION_R2_BUCKET=
ANALYTICS_ENVIRONMENT=local
MONITORING_ENVIRONMENT=local
SCHEDULED_JOBS_ENABLED=false
EMAIL_DELIVERY_MODE=disabled
PUSH_DELIVERY_MODE=disabled
PORT=4000
DATABASE_URL=postgres://ascend:ascend@localhost:5432/ascend
DB_POOL_MAX=10
DB_CONNECTION_TIMEOUT_MS=5000
DB_IDLE_TIMEOUT_MS=30000
DB_STATEMENT_TIMEOUT_MS=30000
CORS_ORIGIN=http://localhost:3000
ONBOARDING_VERSION=v2

# Firebase Admin
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
BOOTSTRAP_OWNER_EMAIL=you@example.com
CRON_SECRET=replace-with-a-long-random-string

# AWS S3
AWS_REGION=ap-southeast-1
AWS_S3_ENDPOINT=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=

# AI
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
AI_MONTHLY_SPEND_LIMIT_CENTS=5000
AI_MONTHLY_FOOD_ANALYSIS_LIMIT=1000
AI_STAGING_DAILY_FOOD_ANALYSIS_LIMIT=50
AI_STAGING_DAILY_FOOD_ANALYSIS_PER_USER_LIMIT=10
AI_STAGING_MONTHLY_FOOD_ANALYSIS_LIMIT=500
AI_MONTHLY_CHAT_LIMIT=3000
AI_MONTHLY_WEEKLY_REPORT_LIMIT=500
AI_FOOD_ANALYSIS_ESTIMATED_COST_CENTS=2
AI_CHAT_ESTIMATED_COST_CENTS=1
AI_WEEKLY_REPORT_ESTIMATED_COST_CENTS=2
FOOD_AI_PERFORMANCE_LOGS=false
BODY_COMPOSITION_AI_DEBUG_LOGS=false
FOOD_AI_REMOTE_IMAGE_HOSTS=

# Payments - Stripe
PAYMENT_PROVIDER=stripe
FRONTEND_URL=http://localhost:3000
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PREMIUM_PRICE_ID=
STRIPE_TRAINER_PRO_PRICE_ID=

# Google Play Billing. Enable only after products and backend verification are configured.
GOOGLE_PLAY_BILLING_ENABLED=false
GOOGLE_PLAY_PACKAGE_NAME=fit.getascend.app
GOOGLE_PLAY_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PLAY_SERVICE_ACCOUNT_PRIVATE_KEY=
GOOGLE_PLAY_TOKEN_ENCRYPTION_KEY=
GOOGLE_PLAY_TOKEN_KEY_VERSION=1
GOOGLE_PLAY_ACCOUNT_OBFUSCATION_SECRET=
GOOGLE_PLAY_PREMIUM_MONTHLY_PRODUCT_ID=ascend_premium_monthly
GOOGLE_PLAY_PREMIUM_MONTHLY_BASE_PLAN_ID=monthly
GOOGLE_PLAY_PREMIUM_MONTHLY_PRICE_CENTS=1999
GOOGLE_PLAY_PREMIUM_YEARLY_PRODUCT_ID=ascend_premium_yearly
GOOGLE_PLAY_PREMIUM_YEARLY_BASE_PLAN_ID=yearly
GOOGLE_PLAY_PREMIUM_YEARLY_PRICE_CENTS=19999
GOOGLE_PLAY_RTDN_ENABLED=false
GOOGLE_PLAY_RTDN_AUDIENCE=
GOOGLE_PLAY_RTDN_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PLAY_ENTITLEMENT_FRESHNESS_HOURS=24

# Athlete Mode kill switch. Individual athletes still require owner activation.
ATHLETE_MODE_ENABLED=true

# Lemon Squeezy legacy fallback
LEMONSQUEEZY_API_BASE_URL=https://api.lemonsqueezy.com/v1
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_PREMIUM_VARIANT_ID=
LEMONSQUEEZY_TRAINER_PRO_VARIANT_ID=
LEMONSQUEEZY_WEBHOOK_SECRET=

# ToyyibPay legacy fallback
TOYYIBPAY_BASE_URL=https://toyyibpay.com
TOYYIBPAY_SECRET_KEY=
TOYYIBPAY_CATEGORY_CODE=
TOYYIBPAY_RETURN_URL=http://localhost:3000/subscription
TOYYIBPAY_CALLBACK_URL=http://localhost:4000/api/v1/webhooks/toyyibpay

# Founder Dashboard Gmail API
# Google Cloud OAuth Web Client. Redirect URI should point to:
# https://YOUR_API_DOMAIN/api/v1/founder/gmail/callback
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://localhost:4000/api/v1/founder/gmail/callback
# Long random secret used to encrypt the stored Gmail refresh token.
GMAIL_TOKEN_ENCRYPTION_KEY=

# Private Workout Capture V1 pilot. Keep false until test accounts are ready.
WORKOUT_CAPTURE_V1=false
